# Supabase
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key — used server-side only (e.g. Stripe webhooks). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_*********"

# Email Notifications (Resend)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY="re_your_resend_api_key"
# The email address to send notifications from (must be verified in Resend)
EMAIL_FROM="Boat Booking <notifications@yourdomain.com>"

# Google Analytics (Optional)
# Get your GA4 Measurement ID from Google Analytics (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Stripe (Subscriptions & Payments)
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create two recurring prices in your Stripe dashboard (or via API) and paste the Price IDs:
#   Monthly plan: £12.99 / month
STRIPE_MONTHLY_PRICE_ID="price_..."
#   Annual plan:  £119.88 / year  (= £9.99 × 12)
STRIPE_YEARLY_PRICE_ID="price_..."
# The public URL of your app (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
